---
import siteSettings from '../content/settings/site.json';
---

<section id="contato" class="py-24 bg-stone-900 text-stone-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
      
      <!-- Informações Físicas & Registros Oficiais -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <span class="text-xs font-semibold text-stone-400 uppercase tracking-widest">
            Canais Oficiais
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-semibold tracking-tight mt-3">
            Inicie um Diagnóstico Institucional
          </h2>
          <p class="text-stone-400 text-base mt-4 leading-relaxed">
            Atendimento técnico diretamente com especialistas. Sem intermediários, sem propostas genéricas.
          </p>
        </div>

        <div class="space-y-4 text-sm text-stone-300">
          <div class="border-t border-stone-800 pt-4">
            <span class="block text-xs uppercase text-stone-400 font-medium">Sede e Endereço Físico</span>
            <p class="mt-1 text-stone-200">{siteSettings.address}</p>
          </div>

          <div class="border-t border-stone-800 pt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <span class="block text-xs uppercase text-stone-400 font-medium">E-mail Corporativo</span>
              <a href={`mailto:${siteSettings.email}`} class="mt-1 text-stone-200 hover:text-white transition-colors block">
                {siteSettings.email}
              </a>
            </div>
            <div>
              <span class="block text-xs uppercase text-stone-400 font-medium">Telefone / WhatsApp</span>
              <a href={`https://wa.me/${siteSettings.whatsapp}`} class="mt-1 text-stone-200 hover:text-white transition-colors block">
                {siteSettings.phone}
              </a>
            </div>
          </div>

          <div class="border-t border-stone-800 pt-4">
            <span class="block text-xs uppercase text-stone-400 font-medium">Horário de Expediente</span>
            <p class="mt-1 text-stone-200">{siteSettings.workingHours}</p>
          </div>

          <div class="border-t border-stone-800 pt-4">
            <span class="block text-xs uppercase text-stone-400 font-medium">Registro e Conformidade</span>
            <p class="mt-1 text-stone-400 text-xs">{siteSettings.legalName} • CNPJ: {siteSettings.taxId}</p>
            <p class="text-stone-400 text-xs">{siteSettings.councilRegistration}</p>
          </div>
        </div>
      </div>

      <!-- Formulário de Contato -->
      <div class="lg:col-span-6">
        <form
          id="contact-form"
          action={`https://wa.me/${siteSettings.whatsapp}`}
          method="GET"
          target="_blank"
          class="bg-stone-950/60 border border-stone-800 rounded-2xl p-8 sm:p-10 space-y-6"
        >
          <h3 class="font-serif text-2xl font-bold text-stone-100">
            Mensagem Direta
          </h3>

          <div class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-medium text-stone-400 uppercase tracking-wider mb-2">
                Seu Nome Completo
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ex: Carlos Albuquerque"
                class="w-full px-4 py-3 rounded-lg bg-stone-900 border border-stone-800 text-stone-100 placeholder-stone-600 focus:outline-none focus:border-stone-500 text-sm"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="company" class="block text-xs font-medium text-stone-400 uppercase tracking-wider mb-2">
                  Empresa / Organização
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="Ex: Indústria ABC"
                  class="w-full px-4 py-3 rounded-lg bg-stone-900 border border-stone-800 text-stone-100 placeholder-stone-600 focus:outline-none focus:border-stone-500 text-sm"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-medium text-stone-400 uppercase tracking-wider mb-2">
                  Telefone / WhatsApp
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="Ex: (11) 98765-4321"
                  class="w-full px-4 py-3 rounded-lg bg-stone-900 border border-stone-800 text-stone-100 placeholder-stone-600 focus:outline-none focus:border-stone-500 text-sm"
                />
              </div>
            </div>

            <div>
              <label for="scope" class="block text-xs font-medium text-stone-400 uppercase tracking-wider mb-2">
                Necessidade Principal
              </label>
              <textarea
                id="scope"
                name="text"
                rows="3"
                required
                placeholder="Descreva brevemente o projeto, volume ou prazo esperado..."
                class="w-full px-4 py-3 rounded-lg bg-stone-900 border border-stone-800 text-stone-100 placeholder-stone-600 focus:outline-none focus:border-stone-500 text-sm resize-none"
              ></textarea>
            </div>
          </div>

          <div id="form-status" class="text-xs text-stone-300 text-center hidden py-1"></div>

          <button
            id="submit-btn"
            type="submit"
            class="w-full py-4 px-6 rounded-lg bg-stone-100 text-stone-950 font-bold text-sm hover:bg-white transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-sm"
          >
            Enviar Mensagem ao Atendimento &rarr;
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script is:inline define:vars={{ whatsappNumber: siteSettings.whatsapp }}>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = String(formData.get('name') || '').trim();
      const company = String(formData.get('company') || '').trim();
      const phone = String(formData.get('phone') || '').trim();
      const text = String(formData.get('text') || '').trim();

      const payload = {
        name,
        company,
        phone,
        text,
        source: 'starter.wbmonster.com.br'
      };

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = 'Gravando mensagem...';
      }

      if (statusEl) {
        statusEl.textContent = 'Enviando lead ao sistema...';
        statusEl.classList.remove('hidden');
      }

      // 1. Post assíncrono para a API interna (BullMQ queue no host)
      try {
        await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        console.warn('Lead async proxy error, fallback to WhatsApp directly:', err);
      }

      if (statusEl) {
        statusEl.textContent = 'Recebido com sucesso! Abrindo WhatsApp...';
      }

      // 2. Redireciona para WhatsApp com o contexto pré-preenchido
      const msg = `Olá! Meu nome é ${name} (${company}).\nTelefone: ${phone}\n\nNecessidade: ${text}`;
      const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;

      setTimeout(() => {
        window.open(waUrl, '_blank');
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = 'Enviar Mensagem ao Atendimento &rarr;';
        }
        form.reset();
        if (statusEl) {
          statusEl.textContent = 'Mensagem enviada com sucesso.';
          setTimeout(() => statusEl.classList.add('hidden'), 4000);
        }
      }, 600);
    });
  }
</script>
