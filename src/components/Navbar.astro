---
import siteSettings from '../content/settings/site.json';
---

<header class="sticky top-0 z-40 bg-[#FBFBFA]/90 backdrop-blur-md border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logotipo / Nome com Serifa de Autoridade -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-lg bg-stone-900 text-white flex items-center justify-center font-serif font-bold text-lg">
        W
      </div>
      <div>
        <span class="font-serif font-bold text-lg sm:text-xl text-stone-900 tracking-tight block leading-none">
          {siteSettings.name}
        </span>
        <span class="text-[10px] tracking-wider text-stone-500 uppercase font-medium mt-0.5 block">
          Governança & Engenharia
        </span>
      </div>
    </a>

    <!-- Menu Desktop -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-600">
      <a href="#trajetoria" class="py-2 hover:text-stone-950 transition-colors">Trajetória</a>
      <a href="#solucoes" class="py-2 hover:text-stone-950 transition-colors">Soluções</a>
      <a href="#simulador" class="py-2 hover:text-stone-950 transition-colors">Simulador</a>
      <a href="#lideranca" class="py-2 hover:text-stone-950 transition-colors">Liderança</a>
      <a href="#depoimentos" class="py-2 hover:text-stone-950 transition-colors">Cases</a>
      <a href="#faq" class="py-2 hover:text-stone-950 transition-colors">Dúvidas</a>
      <a href="#contato" class="py-2 hover:text-stone-950 transition-colors">Contato</a>
    </nav>

    <!-- Botões de Ação: APP PWA, WhatsApp e CMS -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Botão Canônico 'APP' para Instalação PWA (ADR-0123) -->
      <button
        type="button"
        class="pwa-install-trigger inline-flex items-center gap-1.5 px-3 py-2 rounded-full border border-stone-300 bg-stone-100 hover:bg-stone-900 text-stone-700 hover:text-stone-50 text-xs font-bold transition-all shadow-xs hover:shadow active:scale-95 cursor-pointer group"
        title="Instalar Aplicativo no Celular ou Desktop"
        aria-label="Baixar Aplicativo"
      >
        <svg class="w-3.5 h-3.5 shrink-0 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
          <line x1="12" y1="18" x2="12.01" y2="18"></line>
        </svg>
        <span>APP</span>
        <span class="hidden sm:inline-block text-[9px] uppercase font-bold tracking-wider opacity-70 border-l border-current pl-1 ml-0.5">Instalar</span>
      </button>

      <a
        href={`https://wa.me/${siteSettings.whatsapp}?text=Olá,%20gostaria%20de%20conversar%20sobre%20uma%20solução%20para%20minha%20empresa.`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-stone-900 text-stone-50 text-sm font-medium hover:bg-stone-800 transition-colors shadow-xs"
      >
        Atendimento Direto
      </a>
      
      <!-- Link direto para o painel Keystatic CMS -->
      <a
        href="/keystatic"
        class="text-xs px-2.5 py-1.5 rounded-md border border-stone-300 text-stone-600 hover:text-stone-900 hover:border-stone-400 transition-colors"
        title="Painel Administrativo Keystatic CMS"
      >
        CMS Admin
      </a>
    </div>
  </div>
</header>
