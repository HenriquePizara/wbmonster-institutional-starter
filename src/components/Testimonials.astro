---
import fs from 'node:fs';
import path from 'node:path';

const testimonialsDir = path.resolve('./src/content/testimonials');
let testimonialsList: Array<{ author: string; role: string; company: string; quote: string; year: string }> = [];

try {
  if (fs.existsSync(testimonialsDir)) {
    const files = fs.readdirSync(testimonialsDir).filter(f => f.endsWith('.json'));
    testimonialsList = files.map(f => JSON.parse(fs.readFileSync(path.join(testimonialsDir, f), 'utf-8')));
  }
} catch (e) {
  console.error('Erro ao ler depoimentos:', e);
}
---

<section id="depoimentos" class="py-24 bg-[#F4F4F0] border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-16">
      <span class="text-xs font-semibold text-stone-500 uppercase tracking-widest">
        Prova Social Verificável
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-semibold tracking-tight mt-3">
        Quem Opera com Nossas Soluções
      </h2>
      <p class="text-stone-600 text-lg mt-4">
        Depoimentos literais e autorizados de lideranças que confiam na robustez da nossa engenharia.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonialsList.map((item) => (
        <div class="bg-white border border-stone-200/90 rounded-2xl p-8 sm:p-10 shadow-xs flex flex-col justify-between">
          <blockquote class="text-stone-800 font-serif text-xl sm:text-2xl leading-relaxed italic">
            "{item.quote}"
          </blockquote>

          <div class="mt-8 pt-6 border-t border-stone-100 flex items-center justify-between">
            <div>
              <p class="font-bold text-stone-900 text-base capitalize">
                {item.author.replace(/-/g, ' ')}
              </p>
              <p class="text-xs text-stone-500 mt-0.5">
                {item.role} • {item.company}
              </p>
            </div>
            <div class="text-xs font-medium text-stone-400">
              Desde {item.year}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
