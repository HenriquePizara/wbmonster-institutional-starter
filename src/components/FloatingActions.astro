---
import siteSettings from '../content/settings/site.json';

interface Props {
  whatsappText?: string;
}

const {
  whatsappText = `Olá, gostaria de conversar sobre os serviços da ${siteSettings.name}.`
} = Astro.props;

const whatsappUrl = `https://wa.me/${siteSettings.whatsapp}?text=${encodeURIComponent(whatsappText)}`;
---

<!-- Torre Canônica de Botões Flutuantes (ADR-0124) -->
<aside class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 pointer-events-none" aria-label="Ações Rápidas de Contato e Ecossistema">
  <!-- 1. Botão Flutuante WbMonster (Empilhado Acima do WhatsApp) -->
  <div class="flex items-center group relative pointer-events-auto">
    <!-- Tooltip Desktop -->
    <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 mr-2 rounded-xl bg-slate-900/95 text-cyan-400 text-xs font-semibold shadow-xl border border-cyan-500/30 backdrop-blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span>Conheça a WbMonster</span>
    </div>

    <!-- Botão Circular WbMonster -->
    <a
      href="https://wbmonster.com.br"
      target="_blank"
      rel="noopener noreferrer"
      class="w-14 h-14 rounded-full bg-gradient-to-tr from-cyan-600 via-blue-600 to-indigo-600 hover:from-cyan-500 hover:to-blue-500 border border-cyan-400/50 shadow-xl shadow-cyan-950/50 flex items-center justify-center text-white transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-cyan-500/40"
      aria-label="Conheça a WbMonster — Engenharia de Software Autônoma & Ecossistema de IA"
    >
      <!-- Ícone Globo / WbMonster Orb -->
      <svg class="w-7 h-7 shrink-0 transition-transform duration-300 group-hover:rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </a>
  </div>

  <!-- 2. Botão Flutuante WhatsApp (Base do Stack) -->
  <div class="flex items-center group relative pointer-events-auto">
    <!-- Tooltip Desktop -->
    <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 mr-2 rounded-xl bg-slate-900/95 text-emerald-400 text-xs font-semibold shadow-xl border border-emerald-500/30 backdrop-blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Fale no WhatsApp</span>
    </div>

    <!-- Botão Circular WhatsApp -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="relative w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
      aria-label={`Atendimento via WhatsApp de ${siteSettings.name}`}
    >
      <!-- Ícone WhatsApp -->
      <svg class="w-7 h-7 fill-current shrink-0" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
      <!-- Ponto de Status Online -->
      <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-400 border-2 border-white shadow-sm animate-pulse"></span>
    </a>
  </div>
</aside>
