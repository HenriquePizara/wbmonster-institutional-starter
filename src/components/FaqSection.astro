---
import fs from 'node:fs';
import path from 'node:path';

const faqDir = path.resolve('./src/content/faq');
let faqList: Array<{ question: string; answer: string }> = [];

try {
  if (fs.existsSync(faqDir)) {
    const files = fs.readdirSync(faqDir).filter(f => f.endsWith('.json'));
    faqList = files.map(f => JSON.parse(fs.readFileSync(path.join(faqDir, f), 'utf-8')));
  }
} catch (e) {
  console.error('Erro ao ler FAQ:', e);
}

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => {
    const cleanQuestion = item.question.replace(/-/g, ' ');
    const questionText = cleanQuestion.endsWith('?') ? cleanQuestion : `${cleanQuestion}?`;
    return {
      "@type": "Question",
      "name": questionText.charAt(0).toUpperCase() + questionText.slice(1),
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    };
  })
};
---

<section id="faq" class="py-24 bg-[#FBFBFA] border-b border-stone-200">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <span class="text-xs font-semibold text-stone-500 uppercase tracking-widest">
        Perguntas Frequentes
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-semibold tracking-tight mt-3">
        Esclarecimentos Técnicos e Contratuais
      </h2>
    </div>

    <div class="space-y-4">
      {faqList.map((item) => (
        <details class="group bg-white border border-stone-200 rounded-xl p-6 open:border-stone-400 transition-colors">
          <summary class="flex justify-between items-center font-medium text-stone-900 cursor-pointer list-none text-lg">
            <span class="capitalize">{item.question.replace(/-/g, ' ')}?</span>
            <span class="transition group-open:rotate-180 text-stone-500">
              <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-stone-600 mt-4 leading-relaxed text-sm pt-4 border-t border-stone-100">
            {item.answer}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>
