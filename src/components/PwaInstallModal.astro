---
import siteSettings from '../content/settings/site.json';

interface Props {
  appName?: string;
}

const {
  appName = siteSettings.name
} = Astro.props;
---

<!-- Modal de Instalação do Aplicativo PWA (ADR-0123) -->
<div
  id="pwa-install-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pwa-modal-title"
>
  <div class="relative w-full max-w-md bg-stone-50 text-stone-900 rounded-3xl border border-stone-200 p-6 sm:p-7 shadow-2xl transform scale-95 transition-transform duration-200" id="pwa-modal-card">
    <!-- Botão Fechar -->
    <button
      id="pwa-modal-close"
      type="button"
      class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full bg-stone-200/70 hover:bg-stone-200 text-stone-600 transition-colors cursor-pointer"
      aria-label="Fechar"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Cabeçalho do App -->
    <div class="flex items-center gap-3.5 mb-5">
      <div class="w-12 h-12 rounded-2xl overflow-hidden bg-stone-900 text-white flex items-center justify-center font-serif font-bold text-xl shadow-sm shrink-0">
        {appName.charAt(0)}
      </div>
      <div>
        <h3 id="pwa-modal-title" class="font-serif font-bold text-lg text-stone-950 leading-tight">
          {appName}
        </h3>
        <p class="text-xs text-stone-500 font-medium mt-0.5">
          Aplicativo Oficial · PWA Sem Lojas
        </p>
      </div>
    </div>

    <!-- Conteúdo Dinâmico por Plataforma -->
    <!-- Cenário 1: iOS Safari -->
    <div id="pwa-step-ios" class="hidden space-y-3.5 text-sm text-stone-700">
      <p class="font-medium text-stone-900">Como instalar no seu iPhone ou iPad:</p>
      <div class="space-y-2.5 bg-white p-3.5 rounded-2xl border border-stone-200/80">
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</div>
          <p class="text-xs leading-relaxed">
            Toque no botão <strong class="text-stone-950">Compartilhar</strong> 
            <svg class="inline-block w-4 h-4 text-stone-900 align-text-bottom mx-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
            na barra inferior do Safari.
          </p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</div>
          <p class="text-xs leading-relaxed">
            Role as opções para baixo e selecione <strong class="text-stone-950">"Adicionar à Tela de Início"</strong>.
          </p>
        </div>
        <div class="flex items-start gap-3">
          <div class="w-6 h-6 rounded-full bg-stone-900 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</div>
          <p class="text-xs leading-relaxed">
            Toque em <strong class="text-stone-950">"Adicionar"</strong> no canto superior direito para concluir.
          </p>
        </div>
      </div>
    </div>

    <!-- Cenário 2: Android / Chrome / Desktop -->
    <div id="pwa-step-generic" class="space-y-3.5 text-sm text-stone-700">
      <p class="text-xs text-stone-600 leading-relaxed">
        Instale o aplicativo diretamente no seu celular ou computador para acesso instantâneo, navegação offline e sem ocupar espaço da memória.
      </p>
      <button
        id="pwa-modal-action-btn"
        type="button"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-stone-900 hover:bg-stone-800 text-stone-50 font-bold text-sm shadow-md transition-all active:scale-98 cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Instalar Aplicativo Agora</span>
      </button>
      <p id="pwa-generic-fallback" class="text-[11px] text-center text-stone-500">
        Se a janela de instalação automática não abrir, clique no menu <strong>⋮</strong> do navegador e selecione <strong>"Instalar aplicativo"</strong>.
      </p>
    </div>

    <!-- Cenário 3: Já Instalado -->
    <div id="pwa-step-installed" class="hidden text-center py-2 space-y-2">
      <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto mb-1">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <p class="font-bold text-emerald-800 text-sm">Aplicativo já instalado!</p>
      <p class="text-xs text-stone-500">Você já está usando a versão nativa ou o ícone já está disponível na tela inicial do seu aparelho.</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    let deferredPrompt = null;
    const modal = document.getElementById('pwa-install-modal');
    const modalClose = document.getElementById('pwa-modal-close');
    const actionBtn = document.getElementById('pwa-modal-action-btn');
    const stepIos = document.getElementById('pwa-step-ios');
    const stepGeneric = document.getElementById('pwa-step-generic');
    const stepInstalled = document.getElementById('pwa-step-installed');

    const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

    // Capturar o evento nativo de instalação
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      window.pwaDeferredPrompt = e;
      document.querySelectorAll('.pwa-install-trigger').forEach(btn => {
        btn.classList.add('ring-2', 'ring-stone-900/30');
      });
    });

    window.addEventListener('appinstalled', () => {
      deferredPrompt = null;
      window.pwaDeferredPrompt = null;
      console.log('⚡ [PWA] Aplicativo instalado com sucesso pelo usuário!');
      closeModal();
    });

    function openModal() {
      if (!modal) return;

      if (isStandalone) {
        stepIos?.classList.add('hidden');
        stepGeneric?.classList.add('hidden');
        stepInstalled?.classList.remove('hidden');
      } else if (isIos) {
        stepIos?.classList.remove('hidden');
        stepGeneric?.classList.add('hidden');
        stepInstalled?.classList.add('hidden');
      } else {
        stepIos?.classList.add('hidden');
        stepGeneric?.classList.remove('hidden');
        stepInstalled?.classList.add('hidden');
      }

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      const card = document.getElementById('pwa-modal-card');
      card?.classList.remove('scale-95');
      card?.classList.add('scale-100');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      const card = document.getElementById('pwa-modal-card');
      card?.classList.add('scale-95');
      card?.classList.remove('scale-100');
    }

    modalClose?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    actionBtn?.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        console.log('⚡ [PWA] Escolha do usuário:', choice.outcome);
        deferredPrompt = null;
        closeModal();
      } else {
        const fallbackEl = document.getElementById('pwa-generic-fallback');
        if (fallbackEl) {
          fallbackEl.classList.add('text-stone-900', 'font-semibold');
        }
      }
    });

    function attachTriggers() {
      document.querySelectorAll('.pwa-install-trigger').forEach((btn) => {
        btn.removeEventListener('click', handleTriggerClick);
        btn.addEventListener('click', handleTriggerClick);
      });
    }

    async function handleTriggerClick(e) {
      e.preventDefault();
      if (deferredPrompt && !isIos) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        console.log('⚡ [PWA] Escolha do usuário:', choice.outcome);
        deferredPrompt = null;
      } else {
        openModal();
      }
    }

    attachTriggers();
    window.addEventListener('DOMContentLoaded', attachTriggers);
    window.openPwaInstallModal = openModal;
  })();
</script>
