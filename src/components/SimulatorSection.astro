---
const scopeOptions = [
  {
    id: 'diagnostico',
    name: 'Diagnóstico Arquitetural & Auditoria',
    dedication: 'De 3 a 5 dias úteis',
    timeframe: 'Entrega em 7 dias',
    deliverables: [
      'Mapeamento completo de vulnerabilidades e gargalos',
      'Relatório de conformidade com boas práticas e segurança',
      'Matriz de priorização de melhorias técnicas'
    ]
  },
  {
    id: 'implantacao',
    name: 'Implantação Completa de Governança',
    dedication: 'De 2 a 4 semanas',
    timeframe: 'Cronograma faseado',
    deliverables: [
      'Isolamento em contêineres e deploy contínuo em PaaS privada',
      'Monitoramento 24/7 com sentinela de cotas e alertas',
      'Esteira de qualidade automatizada (Lighthouse CI)'
    ]
  },
  {
    id: 'reforma',
    name: 'Migração & Modernização de Legados',
    dedication: 'Sob medida com base no volume',
    timeframe: 'Zero-Downtime garantido',
    deliverables: [
      'Migração assistida sem interrupção de operações',
      'Conversão de arquitetura legada para microsserviços/Astro',
      'Homologação assistida com testes de estresse'
    ]
  }
];
---

<section id="simulador" class="py-24 bg-[#FBFBFA] border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold text-stone-700 uppercase tracking-widest">
        Diagnóstico Pré-Contratual
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-semibold tracking-tight mt-3">
        Simulador de Dimensionamento e Escopo
      </h2>
      <p class="text-stone-600 text-lg mt-4">
        Avalie o cronograma preliminar e os entregáveis para a realidade do seu ambiente corporativo antes mesmo de agendar uma reunião.
      </p>
    </div>

    <!-- Interface Interativa Nativa (Zero Overhead de Framework no Cliente) -->
    <div class="bg-white border border-stone-200/90 rounded-2xl p-6 sm:p-10 shadow-xs" id="simulator-container">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Painel de Seleção -->
        <div class="lg:col-span-6 space-y-6">
          <div>
            <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">
              1. Selecione o Tipo de Demanda Técnica:
            </label>
            <div class="space-y-2" id="scope-buttons">
              {scopeOptions.map((opt, idx) => (
                <button
                  type="button"
                  data-scope={opt.id}
                  class={`scope-btn w-full text-left px-4 py-3.5 rounded-xl border text-sm transition-colors cursor-pointer flex items-center justify-between ${
                    idx === 0
                      ? 'bg-stone-900 text-stone-50 border-stone-900 font-medium active'
                      : 'bg-stone-50/70 text-stone-800 border-stone-200 hover:bg-stone-100 hover:border-stone-300'
                  }`}
                >
                  <span>{opt.name}</span>
                  <span class="badge text-xs bg-stone-800 text-stone-200 px-2 py-0.5 rounded-md" style={idx === 0 ? '' : 'display: none;'}>
                    Ativo
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">
              2. Porte da Operação / Complexidade:
            </label>
            <div class="grid grid-cols-3 gap-2" id="size-buttons">
              <button
                type="button"
                data-size="pequena"
                class="size-btn px-3 py-2.5 rounded-lg border text-xs text-center transition-colors cursor-pointer bg-stone-800 text-white border-stone-800 font-semibold active"
              >
                Até 20 usuários
              </button>
              <button
                type="button"
                data-size="media"
                class="size-btn px-3 py-2.5 rounded-lg border text-xs text-center transition-colors cursor-pointer bg-stone-50 text-stone-700 border-stone-200 hover:bg-stone-100 font-normal"
              >
                21 a 100 usuários
              </button>
              <button
                type="button"
                data-size="corporativa"
                class="size-btn px-3 py-2.5 rounded-lg border text-xs text-center transition-colors cursor-pointer bg-stone-50 text-stone-700 border-stone-200 hover:bg-stone-100 font-normal"
              >
                Acima de 100
              </button>
            </div>
          </div>

          <div class="pt-2">
            <label class="inline-flex items-center gap-2.5 cursor-pointer text-xs font-medium text-stone-700 select-none py-1">
              <input
                type="checkbox"
                id="urgency-checkbox"
                class="w-5 h-5 rounded border-stone-300 text-stone-900 focus:ring-stone-900 cursor-pointer"
              />
              <span>Necessidade de início imediato (Plantão / Regime de Urgência)</span>
            </label>
          </div>
        </div>

        <!-- Projeção Dinâmica do Escopo -->
        <div class="lg:col-span-6 flex flex-col justify-between bg-stone-50/80 border border-stone-200 rounded-xl p-6 sm:p-8">
          <div>
            <span class="text-[11px] font-bold text-stone-600 uppercase tracking-widest block">
              Projeção de Execução
            </span>
            <h3 class="font-serif text-2xl font-bold text-stone-900 mt-2" id="proj-name">
              Diagnóstico Arquitetural & Auditoria
            </h3>
            
            <div class="grid grid-cols-2 gap-4 my-6 py-4 border-y border-stone-200/80">
              <div>
                <span class="block text-xs text-stone-600">Estimativa de Prazo</span>
                <span class="font-serif font-bold text-stone-900 text-base" id="proj-timeframe">
                  Entrega em 7 dias
                </span>
              </div>
              <div>
                <span class="block text-xs text-stone-600">Dedicação Técnica</span>
                <span class="font-serif font-bold text-stone-900 text-base" id="proj-dedication">
                  De 3 a 5 dias úteis
                </span>
              </div>
            </div>

            <div>
              <span class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">
                Entregáveis Técnicos Assegurados:
              </span>
              <ul class="space-y-2 text-xs sm:text-sm text-stone-700" id="proj-deliverables">
                <li class="flex items-start gap-2">
                  <span class="text-stone-900 font-bold">•</span>
                  <span>Mapeamento completo de vulnerabilidades e gargalos</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-900 font-bold">•</span>
                  <span>Relatório de conformidade com boas práticas e segurança</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-stone-900 font-bold">•</span>
                  <span>Matriz de priorização de melhorias técnicas</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-stone-200/80">
            <a
              id="whatsapp-cta"
              href="https://wa.me/5511999999999?text=Olá!%20Realizei%20uma%20estimativa%20no%20simulador%20do%20site%20para%20o%20escopo%20Diagnóstico%20Arquitetural%20&%20Auditoria."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center py-3.5 px-6 rounded-lg bg-stone-900 text-stone-50 text-sm font-medium hover:bg-stone-800 transition-colors cursor-pointer shadow-xs gap-2"
            >
              Iniciar Conversa sobre este Escopo &rarr;
            </a>
            <span class="block text-center text-[11px] text-stone-600 mt-2">
              Sem compromisso de contratação. Resposta técnica em horário comercial.
            </span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script is:inline define:vars={{ scopeOptions }}>
  (function() {
    let currentScope = 'diagnostico';
    let currentSize = 'pequena';
    let isUrgent = false;

    const projName = document.getElementById('proj-name');
    const projTime = document.getElementById('proj-timeframe');
    const projDed = document.getElementById('proj-dedication');
    const projDeliv = document.getElementById('proj-deliverables');
    const waCta = document.getElementById('whatsapp-cta');
    const urgencyCheckbox = document.getElementById('urgency-checkbox');

    function update() {
      const opt = scopeOptions.find(o => o.id === currentScope) || scopeOptions[0];
      if (projName) projName.textContent = opt.name;
      if (projTime) projTime.textContent = opt.timeframe;
      if (projDed) projDed.textContent = opt.dedication;
      
      if (projDeliv) {
        projDeliv.innerHTML = opt.deliverables.map(d => 
          `<li class="flex items-start gap-2"><span class="text-stone-900 font-bold">•</span><span>${d}</span></li>`
        ).join('');
      }

      const msg = encodeURIComponent(
        `Olá! Realizei uma estimativa no simulador do site para o escopo "${opt.name}", porte "${currentSize}"${isUrgent ? ' (com urgência operacional)' : ''}. Gostaria de alinhar os detalhes técnicos.`
      );
      if (waCta) waCta.href = `https://wa.me/5511999999999?text=${msg}`;
    }

    document.querySelectorAll('.scope-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.scope-btn').forEach(b => {
          b.classList.remove('bg-stone-900', 'text-stone-50', 'border-stone-900', 'font-medium');
          b.classList.add('bg-stone-50/70', 'text-stone-800', 'border-stone-200');
          const badge = b.querySelector('.badge');
          if (badge) badge.style.display = 'none';
        });
        btn.classList.add('bg-stone-900', 'text-stone-50', 'border-stone-900', 'font-medium');
        btn.classList.remove('bg-stone-50/70', 'text-stone-800', 'border-stone-200');
        const badge = btn.querySelector('.badge');
        if (badge) badge.style.display = '';

        currentScope = btn.getAttribute('data-scope');
        update();
      });
    });

    document.querySelectorAll('.size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.size-btn').forEach(b => {
          b.classList.remove('bg-stone-800', 'text-white', 'border-stone-800', 'font-semibold');
          b.classList.add('bg-stone-50', 'text-stone-700', 'border-stone-200', 'font-normal');
        });
        btn.classList.add('bg-stone-800', 'text-white', 'border-stone-800', 'font-semibold');
        btn.classList.remove('bg-stone-50', 'text-stone-700', 'border-stone-200', 'font-normal');

        currentSize = btn.getAttribute('data-size');
        update();
      });
    });

    if (urgencyCheckbox) {
      urgencyCheckbox.addEventListener('change', (e) => {
        isUrgent = e.target.checked;
        update();
      });
    }
  })();
</script>
