---
import '../styles/global.css';
import siteSettings from '../content/settings/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${siteSettings.name} — Engenharia & Governança Digital`,
  description = siteSettings.legalName + ' — Soluções corporativas, infraestrutura e governança digital.',
  ogImage = '/og-image.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://wbmonster.com.br');

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": siteSettings.name,
  "legalName": siteSettings.legalName,
  "url": canonicalURL.toString(),
  "telephone": siteSettings.phone,
  "email": siteSettings.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteSettings.address,
    "addressLocality": siteSettings.city,
    "addressCountry": "BR"
  },
  "openingHours": siteSettings.workingHours
};
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preconnect e Fontes Assíncronas (Zero Bloqueio de FCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400..800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400..800&display=swap"
      />
    </noscript>

    <!-- Open Graph / Redes Sociais (WhatsApp, LinkedIn, Twitter) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon & Identidade -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#18181B" />

    <!-- Schema.org JSON-LD para SEO do Google -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
      <!-- WbMonster Universal PWA Standard (ADR-0123) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#18181B" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteSettings.name} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.svg" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('PWA SW Register Error:', err);
          });
        });
      }
    </script>
  </head>
  <body class="bg-[#FBFBFA] text-[#18181B] antialiased min-h-screen flex flex-col selection:bg-stone-900 selection:text-stone-50">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-stone-900 focus:text-stone-50 focus:rounded-lg focus:shadow-lg focus:outline-2 focus:outline-offset-2 focus:outline-stone-900 font-medium text-sm transition-all"
    >
      Pular para o conteúdo principal
    </a>
    <slot name="header" />
    <main id="main-content" tabindex="-1" class="flex-grow focus:outline-none">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
