{
  "name": "wbmonster-institutional-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Boilerplate Canônico para Sites Institucionais WbMonster (Astro + Tailwind CSS v4 + Keystatic + De-AI)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run audit:slop && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit": "lhci autorun",
    "audit:slop": "node scripts/audit-slop.mjs",
    "test:e2e": "playwright-run tests/e2e/contact-form.spec.cjs",
    "hooks:install": "cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.2.1",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^5.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3"
  }
}
